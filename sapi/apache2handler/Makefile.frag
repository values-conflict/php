apache2handler: $(SAPI_APACHE2HANDLER_PATH)

$(SAPI_APACHE2HANDLER_PATH): $(PHP_CORE_DEPS) $(PHP_APACHE2HANDLER_OBJS) $(PHP_MODULE_REGISTRY_OBJS)
	$(BUILD_APACHE2HANDLER)

install-apache2handler: $(SAPI_APACHE2HANDLER_PATH)
	@echo "Installing PHP Apache 2 module:   via apxs"
	@$(APACHE2HANDLER_INSTALL)
